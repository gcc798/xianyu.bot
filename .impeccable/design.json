{
  "schemaVersion": 2,
  "designSystem": {
    "direction": "明亮中性的企业级运营控制台",
    "colors": {
      "primary": "#2f67e8",
      "background": "#f4f6f8",
      "surface": "#ffffff",
      "sidebar": "#f7f8fa",
      "text": "#20242b",
      "textSecondary": "#67707e",
      "border": "#dce1e8",
      "success": "#16875f",
      "warning": "#b96816",
      "error": "#c93c37"
    },
    "typography": {
      "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Microsoft YaHei, sans-serif",
      "baseSize": 14
    },
    "radius": {
      "control": 6,
      "surface": 8
    },
    "spacing": [4, 8, 12, 16, 24, 32]
  },
  "layout": {
    "minimumDesktopWidth": 960,
    "mobileLayout": false,
    "listPage": ["filters", "table", "bottomPagination"],
    "detailPage": ["tabs", "continuousSections"]
  },
  "componentPolicy": {
    "library": "Ant Design",
    "preferLibraryCapabilities": true,
    "statusPresentation": "low-saturation tags",
    "dangerousActionsRequireConfirmation": true
  }
}
