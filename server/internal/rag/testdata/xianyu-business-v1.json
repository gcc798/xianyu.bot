  "corpus": [
    {"id": "return-7d", "title": "七天退货", "text": "买家签收后七天内可以申请退货，商品应保持收到时的状态且不影响再次销售。"},
    {"id": "return-exclusions", "title": "退货例外", "text": "定制商品、已经兑换的虚拟商品以及拆封后影响再次销售的密封商品，不支持无理由退货。"},
    {"id": "refund-unshipped", "title": "未发货退款", "text": "订单尚未发货时可以直接申请退款，卖家应在二十四小时内处理。"},
    {"id": "refund-shipped", "title": "已发货退款", "text": "订单已经发货后不能按未发货流程直接退款；买家应先联系卖家，再根据物流和商品状态申请退货退款。"},
    {"id": "quality-proof", "title": "质量问题举证", "text": "商品存在质量问题时，请买家在四十八小时内提供能够显示问题的清晰照片或视频。"},
    {"id": "shipping-sf", "title": "发货方式", "text": "默认使用顺丰快递，付款后四十八小时内发货，偏远地区时效可能延长。"},
    {"id": "shipping-delay", "title": "物流延迟", "text": "物流超过三天没有更新时，客服会根据订单中的实时物流单号协助查询；静态知识不能确认包裹当前位置。"},
    {"id": "digital-delivery", "title": "虚拟商品交付", "text": "虚拟商品付款后通过平台聊天发送兑换信息，客服不会要求买家前往外部聊天工具接收。"},
    {"id": "digital-refund", "title": "虚拟商品退款", "text": "兑换信息尚未使用时可以联系卖家核验；一旦兑换成功，不支持无理由退款。"},
    {"id": "bargain", "title": "议价规则", "text": "商品支持合理议价，确认最终价格前请勿直接付款；客服不会承诺页面之外的最低价格。"},
    {"id": "authenticity", "title": "商品真伪材料", "text": "二手数码商品可以提供序列号、购买凭证和实拍图供买家核对，但静态材料不能替代平台验货结论。"},
    {"id": "inspection-service", "title": "平台验货", "text": "支持验货服务的商品可以按页面入口下单，由平台指定流程完成核验；是否支持应读取当前商品状态。"},
    {"id": "pickup", "title": "同城自提", "text": "同城买家可以预约自提，自提时当面检查外观和功能，确认无误后再确认收货。"},
    {"id": "pickup-safety", "title": "自提安全", "text": "自提地点和时间应通过平台聊天确认，建议选择公共场所；见面前不要脱离平台付款或提前确认收货。"},
    {"id": "reservation-payment", "title": "预留与付款", "text": "卖家确认后可以短时预留商品；订单和付款必须在平台内完成，不接受私下转账作为预留凭证。"},
    {"id": "stock-realtime", "title": "库存状态", "text": "商品是否仍可购买属于实时状态，客服必须通过商品工具查询，不能仅根据知识库回答有货。"},
    {"id": "condition-grading", "title": "成色说明", "text": "商品成色以详情中的实拍图和瑕疵描述为准；九成新允许轻微使用痕迹，但不应隐瞒影响功能的问题。"},
    {"id": "accessories", "title": "配件清单", "text": "随商品提供的配件以详情页清单为准，未列出的原包装、充电器或赠品不能默认包含。"},
    {"id": "warranty", "title": "保修范围", "text": "仍在厂商保修期内的商品会在详情中标注截止时间和所需凭证；个人卖家不额外承诺未写明的保修。"},
    {"id": "invoice", "title": "发票与购买凭证", "text": "是否提供发票或原始购买凭证以商品详情为准；需要抬头变更时应在付款前确认。"},
    {"id": "shipping-fee", "title": "运费承担", "text": "页面标注包邮时由卖家承担基础运费；退货运费和偏远附加费按退货原因及双方协商处理。"},
    {"id": "address-change", "title": "修改收货地址", "text": "发货前可以联系卖家确认是否能修改地址；已经发货后需查询承运商能力，客服不能保证拦截成功。"},
    {"id": "packaging-record", "title": "打包记录", "text": "贵重和易碎商品发货前会记录外观、配件和打包过程，记录用于发生争议时辅助核验。"},
    {"id": "after-sales-time", "title": "售后处理时效", "text": "收到完整问题描述和必要证据后，客服通常在二十四小时内首次响应；复杂争议以平台处理进度为准。"}
  ],
